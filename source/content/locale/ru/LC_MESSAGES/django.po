#: accounts/templates/accounts/emails/code_claimed.html:24
#: accounts/templates/accounts/emails/code_claimed.txt:1
#, python-format
msgid "%(claimer)s claimed one of your codes!"
msgstr "%(claimer)s активировал(а) один из ваших кодов!"

#: accounts/templates/accounts/emails/code_claimed.html:27
#: accounts/templates/accounts/emails/code_claimed.txt:3
#, python-format
msgid ""
"User %(claimer)s just claimed one of the QR codes you handed out and named it"
" \"%(stone_name)s\"."
msgstr ""
"%(claimer)s только что активировал(а) один из QR-кодов, которые вы раздали, и"
" назвал(а) его «%(stone_name)s»."

#: accounts/templates/accounts/emails/code_claimed.html:30
#: accounts/templates/accounts/emails/code_claimed.txt:5
msgid "You can see your codes and stones in My Stones on StoneWalker."
msgstr ""
"Ваши коды и камни можно посмотреть в разделе «Мои камни» на StoneWalker."

#: accounts/templates/accounts/emails/code_claimed.html:33
#: accounts/templates/accounts/emails/code_claimed.txt:7
#: accounts/templates/accounts/emails/stone_moved.html:38
#: accounts/templates/accounts/emails/stone_moved.txt:7
#: accounts/templates/accounts/emails/stone_scanned.html:45
#: accounts/templates/accounts/emails/stone_scanned.txt:9
msgid "You can manage your notification preferences in your profile settings."
msgstr "Настройки уведомлений можно изменить в профиле."

#: accounts/templates/accounts/emails/confirm_find.html:24
#: accounts/templates/accounts/emails/confirm_find.txt:7
msgid "Confirm your find"
msgstr "Подтвердите находку"

#: accounts/templates/accounts/emails/confirm_find.html:27
#: accounts/templates/accounts/emails/confirm_find.txt:9
#, python-format
msgid "Thanks for recording your find of \"%(stone_name)s\"!"
msgstr "Спасибо, что отметили находку камня «%(stone_name)s»!"

#: accounts/templates/accounts/emails/confirm_find.html:27
#: accounts/templates/accounts/emails/confirm_find.txt:9
msgid "Thanks for recording your stone find!"
msgstr "Спасибо, что отметили найденный камень!"

#: accounts/templates/accounts/emails/confirm_find.html:30
#: accounts/templates/accounts/emails/confirm_find.txt:11
msgid ""
"Set a password to confirm your email. Your find then goes live on the map and"
" your StoneWalker account is ready."
msgstr ""
"Задайте пароль, чтобы подтвердить почту. После этого ваша находка появится на"
" карте, а аккаунт StoneWalker будет готов."

#: accounts/templates/accounts/emails/confirm_find.html:36
msgid "Confirm & set password"
msgstr "Подтвердить и задать пароль"

#: accounts/templates/accounts/emails/confirm_find.html:49
#: accounts/templates/accounts/emails/confirm_find.txt:15
msgid "If you did not submit a stone find, you can safely ignore this email."
msgstr "Если вы не отмечали находку камня, просто проигнорируйте это письмо."

#: accounts/templates/accounts/emails/forgotten_username.html:28
#: accounts/templates/accounts/emails/forgotten_username.txt:7
msgid "Your Username"
msgstr "Ваше имя пользователя"

#: accounts/templates/accounts/emails/forgotten_username.html:31
#: accounts/templates/accounts/emails/forgotten_username.txt:9
msgid "Your username is:"
msgstr "Ваше имя пользователя:"

#: accounts/templates/accounts/emails/forgotten_username.html:43
#: accounts/templates/accounts/emails/forgotten_username.txt:13
msgid ""
"If you did not request this information, you can safely ignore this email."
msgstr ""
"Если вы не запрашивали эту информацию, можете спокойно проигнорировать это "
"письмо."

#: accounts/templates/accounts/emails/restore_password_email.html:28
#: accounts/templates/accounts/emails/restore_password_email.txt:7
msgid "Password Reset"
msgstr "Сброс пароля"

#: accounts/templates/accounts/emails/restore_password_email.html:31
#: accounts/templates/accounts/emails/restore_password_email.txt:9
msgid ""
"You received this email because you requested a password reset for your user "
"account."
msgstr ""
"Вы получили это письмо, потому что запросили сброс пароля для вашей учётной "
"записи."

#: accounts/templates/accounts/emails/restore_password_email.html:35
#: accounts/templates/accounts/emails/restore_password_email.txt:11
msgid "Please, go to the following page and choose a new password:"
msgstr "Пожалуйста, перейдите на указанную страницу и выберите новый пароль:"

#: accounts/templates/accounts/emails/restore_password_email.html:41
msgid "Reset Password"
msgstr "Сбросить пароль"

#: accounts/templates/accounts/emails/restore_password_email.html:54
#: accounts/templates/accounts/emails/restore_password_email.txt:15
msgid ""
"If you did not request this password reset, you can safely ignore this email."
msgstr ""
"Если вы не запрашивали сброс пароля, можете спокойно проигнорировать это "
"письмо."

#: accounts/templates/accounts/emails/stone_moved.html:27
#: accounts/templates/accounts/emails/stone_moved.txt:1
msgid "Your stone moved!"
msgstr "Ваш камень переместился!"

#: accounts/templates/accounts/emails/stone_moved.html:30
#: accounts/templates/accounts/emails/stone_moved.txt:3
#, python-format
msgid "Your stone \"%(stone_name)s\" was moved by %(mover_name)s."
msgstr "%(mover_name)s переместил(а) ваш камень «%(stone_name)s»."

#: accounts/templates/accounts/emails/stone_moved.html:34
#: accounts/templates/accounts/emails/stone_moved.txt:5
#, python-format
msgid "Total distance traveled: %(distance)s km."
msgstr "Всего пройдено: %(distance)s км."

#: accounts/templates/accounts/emails/stone_scanned.html:28
#: accounts/templates/accounts/emails/stone_scanned.txt:1
msgid "Your stone was scanned!"
msgstr "Ваш камень отсканировали!"

#: accounts/templates/accounts/emails/stone_scanned.html:31
#: accounts/templates/accounts/emails/stone_scanned.txt:3
#, python-format
msgid ""
"Someone found your stone \"%(stone_name)s\"! User %(mover_name)s just scanned"
" it."
msgstr ""
"Кто-то нашёл ваш камень «%(stone_name)s»! %(mover_name)s только что "
"отсканировал(а) его."

#: accounts/templates/accounts/emails/stone_scanned.html:36
#: accounts/templates/accounts/emails/stone_scanned.txt:5
msgid "Their comment:"
msgstr "Комментарий:"

#: accounts/templates/accounts/emails/stone_scanned.html:41
#: accounts/templates/accounts/emails/stone_scanned.txt:7
#, python-format
msgid "Your stone has now traveled %(distance)s km!"
msgstr "Ваш камень уже прошёл %(distance)s км!"

